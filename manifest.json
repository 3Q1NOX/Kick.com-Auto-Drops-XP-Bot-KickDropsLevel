{
  "manifest_version": 3,
  "name": "Kick Drops & Level",
  "version": "1.3.108",
  "description": "Sadece Drop farm ve Level bot — temiz arayüz. FPS Boost / sohbet temizliği sıfırdan yazıldı.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "cookies",
    "tabs",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://kick.com/*",
    "https://*.kick.com/*",
    "https://web.kick.com/*",
    "https://player.kick.com/*",
    "wss://*.pusher.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Kick Drops & Level"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "content/settings.js",
        "content/errlog.js",
        "content/net.js",
        "content/menu-color.js",
        "content/ui-scale.js",
        "content/audio-guard.js",
        "content/quality-160.js",
        "content/video-filter.js",
        "content/fps-boost.js",
        "content/chat-clean.js",
        "content/stall-guard.js",
        "content/i18n.js",
        "content/level-bot.js",
        "content/drops.js",
        "content/opacity.js",
        "content/menu.js",
        "content/features.js",
        "content/keys-overlay.js",
        "content/dashboard.js",
        "content/level-hud.js",
        "content/coord-picker.js",
        "content/extras.js",
        "content/daily-reward.js",
        "content/daily-hud.js",
        "content/daily-ring.js",
        "content/main.js"
      ],
      "css": [
        "content/imthemes.css",
        "content/menu.css",
        "content/panels.css",
        "content/dashboard.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://kick.com/*",
        "https://*.kick.com/*"
      ]
    }
  ]
}